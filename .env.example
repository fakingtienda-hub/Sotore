# ─────────────────────────────────────────────────────────────
# FAKINGSTORE — Variables de entorno
# Copia este archivo a .env.local y completa los valores reales.
# JAMÁS subas .env.local al repositorio ni expongas secretos al cliente.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# URL pública del sitio (usada en emails, canonical, OG).
# OJO: el login NO depende de esta variable (el cliente siempre llama a su
# propio origen). Si development va a otra URL que esta, añádela abajo.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Orígenes extra que better-auth acepta en cookies y CSRF, separados por coma.
# Sin esto, entrar desde un origen distinto a NEXT_PUBLIC_APP_URL falla con
# 403 "Invalid origin". Ejemplos: http://localhost:3000, un túnel de Cloudflare.
AUTH_TRUSTED_ORIGINS=
# Nombre de la tienda / marca (se usa en títulos, emails y seed).
NEXT_PUBLIC_STORE_NAME=Fakingstore

# ── Base de datos (PostgreSQL) ───────────────────────────────
# Cadena de conexión. En local puede ser un Postgres Docker/local.
# En producción: Supabase, VPS o managed Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fakingstore
# Conexiones del pool (opcional, default 5)
DATABASE_POOL_MAX=5

# ── Autenticación ────────────────────────────────────────────
# Secreto de sesiones (genera uno: openssl rand -base64 32)
# NUNCA uses "secret" en producción — todas las sesiones serían forgeables.
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
# Administrador creado por `npm run db:seed` / `npm run reset:admin-password`.
# Mínimo 12 caracteres (seed y reset lo exigen y se niegan con menos).
ADMIN_EMAIL=admin@fakingstore.com
ADMIN_PASSWORD=change-me-strong-password

# ── Storage (S3-compatible / Supabase Storage) ───────────────
# Bucket privado donde viven los archivos de producto.
STORAGE_BUCKET=product-files
# --- Cloudflare R2 (S3-compatible) -------------------------------------------
# Rellena estas 4 para activar el driver remoto. Mientras falte STORAGE_ENDPOINT
# o las claves, la app usa el driver local en disco.
# STORAGE_ENDPOINT:   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_REGION:     R2 no usa regiones; el driver fija "auto".
# Credenciales: R2 -> Manage R2 API Tokens -> token con Object Read & Write
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Vigencia de las URLs firmadas de descarga (segundos). Corta a propósito: la URL
# da acceso al objeto sin pasar por la función de Vercel.
SIGNED_URL_TTL_SECONDS=900
# Storage local (Fase 4): carpeta bajo el repo y URL base pública.
STORAGE_DIR=storage
STORAGE_BASE_URL=/api/files
# Tamaño máximo permitido para subidas (en bytes). Default: 512 MB.
STORAGE_MAX_FILE_BYTES=536870912

# ── Email (capa desacoplada) ─────────────────────────────────
# Proveedor: "resend" | "smtp" | "console".
# Todo esto se puede configurar desde /admin/settings (SMTP/Mailgun incluido);
# estas variables quedan como respaldo y como valores por defecto.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
# Remitente que ve el cliente (debe estar verificado en el proveedor)
EMAIL_FROM=Fakingstore <hola@fakingstore.com>
# Presupuesto diario de correo. El plan Free de Mailgun son 100/día y ESE cupo
# es compartido: el correo de una compra compite con el magic link de cualquier
# visitante. Al llegar al límite se omite el envío y queda registrado en
# `email_log` (visible en /admin/settings), en vez de que el proveedor lo
# rechace. La reserva son los turnos que quedan libres para los correos
# críticos (compra, magic link, reseteo) frente a los no críticos.
EMAIL_DAILY_LIMIT=100
EMAIL_CRITICAL_RESERVE=20
# SMTP (Mailgun): host smtp.mailgun.org, puerto 587 (STARTTLS) o 465 (TLS).
# EMAIL_SMTP_SECURE=true solo para puerto 465 (TLS implícito).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# Mailgun por API HTTP (opcional alternativa al SMTP). La clave y el dominio se
# configuran desde /admin/settings; la base puede cambiarse por región o pruebas.
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAILGUN_API_BASE=https://api.mailgun.net

# ── Wompi (pagos Colombia) ───────────────────────────────────
# Llave pública de comercio (prefijo pub_test_ en sandbox, pub_prod_ en producción).
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
# Secreto de INTEGRIDAD (no es la llave privada): se usa para firmar el checkout.
# Se obtiene en "Developers > Secrets for technical integration" del dashboard.
WOMPI_INTEGRITY_SECRET=
# Secreto de eventos del webhook (se valida al recibir confirmaciones)
WOMPI_EVENTS_SECRET=

# Autoriza a /api/cron/reconcile (repara pagos aprovados que no entregaron el
# producto y recupera pagos APPROVED de órdenes pendientes). Vacío =endpoint
# deshabilitado (responde 503). Genera con: openssl rand -base64 32
# Invócalo desde un cron externo: curl -H "Authorization: Bearer $RECONCILE_SECRET"
#   https://<tu-dominio>/api/cron/reconcile
RECONCILE_SECRET=
# Entorno: "sandbox" | "production"
WOMPI_ENV=sandbox
# URL base de la API de Wompi (según entorno)
WOMPI_API_URL=https://sandbox.wompi.co/v1